# Amazon Bedrock (Converse API, bearer token auth)
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_bearer_token
AWS_REGION=us-east-1
BEDROCK_CLAUDE_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Together AI, only needed to regenerate the sample photos (scripts/make-samples.mjs)
TOGETHER_API_KEY=your_together_api_key

# API server port (default 8303)
PORT=8303
