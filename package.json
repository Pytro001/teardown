{
  "name": "teardown",
  "version": "1.0.0",
  "private": true,
  "description": "Snap any object and see what is inside it: every part, what it is made of, and how it was made.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --port 5303 --strictPort",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc -p web/tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 5303",
    "test": "node scripts/test-schema.mjs",
    "samples:images": "node --env-file-if-exists=.env scripts/make-samples.mjs",
    "samples:cache": "node --env-file-if-exists=.env scripts/cache-samples.mjs"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
